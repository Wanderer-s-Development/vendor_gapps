// WandererOS GApps - Core ARM64 Architecture

soong_namespace {
    imports: ["vendor/gapps/common"],
}

android_app_import {
    name: "Phonesky",
    owner: "gapps",
    apk: "proprietary/product/priv-app/Phonesky/Phonesky.apk",
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    product_specific: true,
}

android_app_import {
    name: "Velvet",
    owner: "gapps",
    apk: "proprietary/product/priv-app/Velvet/Velvet.apk",
    overrides: ["QuickSearchBox"],
    preprocessed: true,
    presigned: true,
    enforce_uses_libs: false,
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    product_specific: true,
}

android_app_import {
    name: "GooglePhotos",
    owner: "gapps",
    apk: "proprietary/product/app/GooglePhotos/GooglePhotos.apk",
    overrides: ["Gallery2"],
    preprocessed: true,
    presigned: true,
    enforce_uses_libs: false,
    dex_preopt: {
        enabled: false,
    },
    product_specific: true,
}

android_app_import {
    name: "SetupWizard",
    owner: "gapps",
    apk: "proprietary/system_ext/priv-app/SetupWizard/SetupWizard.apk",
    overrides: ["Provision"],
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    system_ext_specific: true,
}

cc_prebuilt_library_shared {
    name: "libjni_latinimegoogle",
    srcs: ["proprietary/product/lib64/libjni_latinimegoogle.so"],
    prefer: true,
    product_specific: true,
}

prebuilt_apex {
    name: "com.google.android.gmssystem.prodvic",
    owner: "gapps",
    src: "proprietary/product/apex/com.google.android.gmssystem.prodvic.apex",
    filename: "com.google.android.gmssystem.prodvic.apex",
    apps: ["PrebuiltGmsCoreVic"],
    product_specific: true,
}
